{
  "name": "aio-plugin-portal",
  "version": "0.3.0",
  "description": "在期望态里协调 DNS（本地/Cloudflare/腾讯云/华为云）、Caddy 反代、证书与内网访问策略，把别名站点的可见范围钉死在登记表里；删除一条记录会连带清干净站点、解析与映射产物并反向校验。",
  "type": "module",
  "license": "MIT",
  "bin": {
    "aio-plugin-portal": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "config",
    "README.md",
    "skills"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test",
    "prepack": "npm run build",
    "prepare": "node scripts/build.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/org-aio/aio-plugin-portal.git"
  }
}
